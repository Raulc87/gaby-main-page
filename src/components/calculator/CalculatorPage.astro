---
// Gaby's calculator page (US-044, UX_UI_DIRECTION.md sections 5.6, 6.7, 6.8 and 6.10,
// CONTENT.md section 11): the header, then one step at a time in place (your numbers, your
// details, the result). The computation runs in the browser (calculatorController.ts); the
// five figures never leave it. The page files in src/pages/{es,en} only pass the language.
// Without JavaScript the cards stay hidden and the link to apply shows instead.
import Button from '../layout/Button.astro';
import PrivacyNotice from '../lead/PrivacyNotice.astro';
import { getCommon, type Language } from '../../i18n';
import { CALCULATOR_ENDPOINT, CONTACT_EMAIL } from '../../lib/lead/config';
import { CRC_PER_USD } from '../../lib/calculator/config';
import { getCalculator } from '../../lib/calculator/dictionary';
import { FIGURE_KEYS, SHARES_ANSWERS, type FigureKey } from '../../lib/calculator/types';
import { GAUGE_STOPS } from '../../lib/calculator/gauge';
import { getForm } from '../../lib/lead/dictionaries';
import { splitTemplate } from '../../lib/lead/format';
import { parseEmphasis } from '../../lib/site/emphasis';
import { pageHref } from '../../lib/site/links';
import { IS_PREVIEW } from '../../lib/site/preview';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const calc = getCalculator(lang);
const form = getForm(lang);
const common = getCommon(lang);
const title = parseEmphasis(calc.title);
const consent = splitTemplate(calc.capture.consent.text, 'privacy_notice_link');

const FIELD_CLASS =
  'mt-1 block min-h-12 w-full rounded-[2px] border border-field-line bg-ivory px-3 py-2 text-charcoal placeholder:text-muted focus:border-heritage-blue focus:ring-2 focus:ring-heritage-blue focus:outline-none';
const MONEY_FIELD_CLASS = `${FIELD_CLASS} pl-9`;
const CHECKBOX_CLASS =
  'mt-0.5 h-4 w-4 shrink-0 rounded-sm outline-1 -outline-offset-1 outline-field-line accent-heritage-blue focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-heritage-blue';

/** The five questions in order: their copy, and the hint where Gaby has one. */
const figureCopy: Record<FigureKey, { label: string; hint?: string }> = {
  expenses: calc.figures.expenses,
  savings: calc.figures.savings,
  investments: calc.figures.investments,
  solidarity: calc.figures.solidarity,
  passive: calc.figures.passive,
};

/** The gauge's colour stretches, as a share of the bar (UX section 6.8: 0-3, 3-6, 6-12, 12 and above). */
const GAUGE_SEGMENTS = [
  { width: 'w-[12.5%]', color: 'bg-terracotta' },
  { width: 'w-[12.5%]', color: 'bg-terracotta-soft' },
  { width: 'w-1/4', color: 'bg-soft-gold' },
  { width: 'w-1/2', color: 'bg-sand' },
];
const gaugeLabels = GAUGE_STOPS.map((stop, index) => ({
  text: index === GAUGE_STOPS.length - 1 ? calc.result.gaugeMax : String(stop),
  left: (index / (GAUGE_STOPS.length - 1)) * 100,
}));

const scriptCopy = {
  preview: IS_PREVIEW,
  language: lang,
  endpoint: CALCULATOR_ENDPOINT,
  contactEmail: CONTACT_EMAIL,
  crcPerUsd: CRC_PER_USD,
  figureErrors: {
    expenses: calc.errors.expenses,
    number: calc.errors.number,
    shares: calc.errors.shares,
  },
  fieldErrors: form.fieldErrors,
  submit: { idle: calc.capture.submit, submitting: form.submit.submitting },
  submissionError: splitTemplate(form.submissionError, 'contact_email'),
  rateLimited: splitTemplate(form.rateLimited, 'contact_email'),
  zones: calc.result.zones,
  unit: calc.result.unit,
};
---

<section class="bg-ivory py-12 lg:py-20">
  <div class="mx-auto max-w-[640px] px-4">
    <header>
      <p class="text-[13px] font-semibold uppercase tracking-[0.16em] text-heritage-blue">{calc.eyebrow}</p>
      <h1 class="mt-3 text-[clamp(1.75rem,1.3rem+2vw,2.5rem)] leading-tight">
        {
          title.map((segment) =>
            segment.emphasis ? (
              <em class="italic text-heritage-blue">{segment.text}</em>
            ) : (
              segment.text
            ),
          )
        }
      </h1>
      <p class="mt-4 text-charcoal">{calc.lead}</p>
    </header>

    <!-- Without JavaScript the calculator cannot run: the link to apply stays. -->
    <noscript>
      <div class="mt-8">
        <Button variant="blue" href={pageHref('vip', lang)} label={common.cta.vip_apply} />
      </div>
    </noscript>

    <div id="calc-root" data-calculator hidden data-copy={JSON.stringify(scriptCopy)} class="mt-8">
      <!-- Honeypot, as on the VIP form (LeadForm.astro): its own <form>, outside the visible ones, off-screen. -->
      <form
        id="calc-hp-form"
        aria-hidden="true"
        class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden"
      >
        <input
          id="calc-hp"
          name="hp_field"
          type="text"
          tabindex="-1"
          autocomplete="off"
          data-1p-ignore
          data-lpignore="true"
          data-bwignore="true"
          data-form-type="other"
        />
      </form>

      <!-- Step 1: your numbers -->
      <div id="calc-step-questions" class="rounded-[4px] border border-sand border-t-4 border-t-heritage-blue bg-surface p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="calc-questions-title" tabindex="-1" class="text-2xl text-charcoal outline-none">
            {calc.figures.title}
          </h2>
          <div
            role="group"
            aria-label={calc.figures.currency.label}
            class="inline-flex rounded-full border-[1.5px] border-field-line bg-surface p-0.5"
          >
            {
              (['USD', 'CRC'] as const).map((currency) => (
                <button
                  type="button"
                  data-currency={currency}
                  aria-pressed={currency === 'USD' ? 'true' : 'false'}
                  class="min-h-11 min-w-16 rounded-full px-4 text-sm font-bold text-charcoal aria-pressed:bg-heritage-blue aria-pressed:text-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-heritage-blue"
                >
                  {currency === 'USD' ? calc.figures.currency.usd : calc.figures.currency.crc}
                </button>
              ))
            }
          </div>
        </div>
        <p class="mt-4 rounded-[2px] bg-ivory px-4 py-3 text-sm text-charcoal">{calc.figures.exampleNote}</p>

        <form id="calc-questions-form" novalidate class="mt-6 space-y-5">
          {
            FIGURE_KEYS.map((key) => (
              <div>
                <label for={`calc-${key}`} class="block text-sm font-semibold text-charcoal">
                  {figureCopy[key].label}
                </label>
                <div class="relative">
                  <span
                    data-currency-symbol
                    aria-hidden="true"
                    class="pointer-events-none absolute top-1/2 left-3 mt-0.5 -translate-y-1/2 text-muted"
                  >
                    $
                  </span>
                  <input
                    id={`calc-${key}`}
                    name={key}
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    aria-describedby={`${figureCopy[key].hint ? `calc-${key}-hint ` : ''}calc-${key}-error`}
                    class={MONEY_FIELD_CLASS}
                  />
                </div>
                {figureCopy[key].hint && (
                  <p id={`calc-${key}-hint`} class="mt-1 text-sm text-muted">
                    {figureCopy[key].hint}
                  </p>
                )}
                <p id={`calc-${key}-error`} role="alert" class="mt-1 text-sm text-red-700" />
              </div>
            ))
          }

          <div>
            <label for="calc-shares" class="block text-sm font-semibold text-charcoal">
              {calc.figures.shares.label}
            </label>
            <select
              id="calc-shares"
              name="shares"
              required
              aria-required="true"
              aria-describedby="calc-shares-error"
              class={FIELD_CLASS}
            >
              <option value="" selected>{calc.figures.shares.placeholder}</option>
              {SHARES_ANSWERS.map((answer) => <option value={answer}>{calc.figures.shares.options[answer]}</option>)}
            </select>
            <p id="calc-shares-error" role="alert" class="mt-1 text-sm text-red-700" />
          </div>

          <Button variant="blue" type="submit" label={calc.next} class="w-full" id="calc-next" />
        </form>
      </div>

      <!-- Step 2: your details -->
      <div id="calc-step-details" hidden class="rounded-[4px] border border-sand border-t-4 border-t-heritage-blue bg-surface p-6 sm:p-8">
        <h2 id="calc-details-title" tabindex="-1" class="text-2xl text-charcoal outline-none">
          {calc.capture.title}
        </h2>
        <p class="mt-3 text-charcoal">{calc.capture.body}</p>

        <form id="calc-details-form" novalidate class="mt-6 space-y-5">
          <div>
            <label for="calc-name" class="block text-sm font-semibold text-charcoal">{form.name.label}</label>
            <input
              id="calc-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              aria-required="true"
              aria-describedby="calc-name-hint calc-name-error"
              class={FIELD_CLASS}
            />
            <p id="calc-name-hint" class="mt-1 text-sm text-muted">{form.name.hint}</p>
            <p id="calc-name-error" role="alert" class="mt-1 text-sm text-red-700"></p>
          </div>

          <div>
            <label for="calc-email" class="block text-sm font-semibold text-charcoal">{form.email.label}</label>
            <input
              id="calc-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              aria-required="true"
              aria-describedby="calc-email-error"
              class={FIELD_CLASS}
            />
            <p id="calc-email-error" role="alert" class="mt-1 text-sm text-red-700"></p>
          </div>

          <div>
            <label for="calc-phone" class="block text-sm font-semibold text-charcoal">
              {calc.capture.phoneLabel}
            </label>
            <input
              id="calc-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              aria-describedby="calc-phone-hint calc-phone-error"
              class={FIELD_CLASS}
            />
            <p id="calc-phone-hint" class="mt-1 text-sm text-muted">{form.phone.hint}</p>
            <p id="calc-phone-error" role="alert" class="mt-1 text-sm text-red-700"></p>
          </div>

          <div>
            <label class="flex min-h-11 items-start gap-2 text-sm text-charcoal">
              <input
                id="calc-consent"
                name="consent"
                type="checkbox"
                required
                aria-required="true"
                aria-describedby="calc-consent-error"
                class={CHECKBOX_CLASS}
              />
              <span>
                {consent.before}
                <button
                  type="button"
                  id="privacy-notice-trigger"
                  aria-haspopup="dialog"
                  aria-controls="privacy-notice-dialog"
                  class="inline-flex min-h-11 items-center text-heritage-blue underline underline-offset-2 hover:text-charcoal"
                >
                  {calc.capture.consent.linkLabel}
                </button>
                {consent.after}
              </span>
            </label>
            <p id="calc-consent-error" role="alert" class="mt-1 text-sm text-red-700"></p>
          </div>

          <!-- Optional and unticked: only leads who tick it enter the email sequence (FR-035, BR-012). -->
          <label class="flex min-h-11 items-start gap-2 text-sm text-charcoal">
            <input id="calc-marketing" name="marketing" type="checkbox" class={CHECKBOX_CLASS} />
            <span>{calc.capture.marketing}</span>
          </label>

          <p id="calc-submission-error" role="alert" hidden class="text-sm text-red-700"></p>

          <Button
            variant="blue"
            type="submit"
            label={calc.capture.submit}
            id="calc-submit"
            class="w-full disabled:pointer-events-none disabled:opacity-50 disabled:hover:translate-y-0"
          />
        </form>
      </div>

      <!-- Step 3: the result -->
      <div id="calc-step-result" hidden class="space-y-4">
        <div class="rounded-[4px] bg-heritage-blue p-6 text-ivory sm:p-8">
          <h2
            id="calc-result-title"
            tabindex="-1"
            class="font-sans text-[13px] font-semibold uppercase tracking-[0.16em] text-ivory outline-none"
          >
            {calc.result.label}
          </h2>
          <p id="calc-result-months" class="mt-3 flex items-baseline gap-3 text-ivory">
            <span id="calc-result-number" class="font-serif text-[clamp(3rem,2.4rem+3vw,4.5rem)] leading-none font-medium"></span>
            <span id="calc-result-unit" class="text-lg"></span>
          </p>
          <p
            id="calc-zone-pill"
            data-zone="alert"
            class="mt-4 inline-flex rounded-full px-4 py-1.5 font-sans text-[13px] font-bold uppercase tracking-[0.14em] text-charcoal data-[zone=critical]:bg-terracotta data-[zone=alert]:bg-terracotta-soft data-[zone=building]:bg-soft-gold data-[zone=path_to_freedom]:bg-sand data-[zone=solid_cushion]:bg-sand data-[zone=financially_free]:bg-soft-gold"
          >
            <span id="calc-zone-label"></span>
          </p>
        </div>

        <div class="rounded-[4px] border border-sand bg-surface p-6 sm:p-8">
          <!-- The gauge is decorative: the months and the zone are already in words (UX section 6.8). -->
          <div aria-hidden="true" class="pb-1">
            <div class="relative">
              <div class="flex h-3.5 overflow-hidden rounded-full">
                {GAUGE_SEGMENTS.map((segment) => <span class={`${segment.width} ${segment.color}`} />)}
              </div>
              <span
                id="calc-gauge-marker"
                class="absolute -top-1 h-[22px] w-[3px] -translate-x-1/2 rounded-full bg-charcoal"
                style="left: 0%"
              ></span>
            </div>
            <div class="relative mt-2 h-5 text-xs text-muted">
              {
                gaugeLabels.map((label) => (
                  <span
                    class={`absolute whitespace-nowrap ${label.left === 0 ? '' : label.left === 100 ? '-translate-x-full' : '-translate-x-1/2'}`}
                    style={`left: ${label.left}%`}
                  >
                    {label.text}
                  </span>
                ))
              }
            </div>
          </div>

          <h3 id="calc-zone-title" class="mt-4 font-serif text-2xl font-medium text-charcoal"></h3>
          <p id="calc-zone-body" class="mt-3 text-charcoal"></p>

          <dl class="mt-6 divide-y divide-sand border-y border-sand">
            <div class="flex flex-wrap items-baseline justify-between gap-2 py-3">
              <dt class="text-sm text-muted">{calc.result.available}</dt>
              <dd id="calc-available-amount" class="text-lg font-bold text-charcoal"></dd>
            </div>
            <div class="flex flex-wrap items-baseline justify-between gap-2 py-3">
              <dt class="text-sm text-muted">{calc.result.gap}</dt>
              <dd id="calc-gap-amount" class="text-lg font-bold text-charcoal"></dd>
            </div>
          </dl>

          <p id="calc-alert" hidden class="mt-6 rounded-[2px] bg-alert-tint p-4 text-charcoal">
            <strong class="font-bold">{calc.result.alert.lead}</strong>
            {' '}{calc.result.alert.body}
          </p>
        </div>

        <div class="rounded-[4px] bg-heritage-blue p-6 text-ivory sm:p-8">
          <h3 class="font-sans text-xl font-bold text-ivory">{calc.result.nextStep.title}</h3>
          <p class="mt-3 text-ivory">{calc.result.nextStep.body}</p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <Button variant="gold" href={pageHref('vip', lang)} label={common.cta.vip_apply} onBlue />
            <button
              type="button"
              id="calc-restart"
              class="inline-flex min-h-[52px] items-center justify-center rounded-[2px] border-[1.5px] border-ivory px-6 py-3 text-base font-bold text-ivory transition hover:bg-ivory hover:text-heritage-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ivory"
            >
              {calc.result.restart}
            </button>
          </div>
        </div>

        {IS_PREVIEW && <p data-preview-note class="text-sm font-semibold text-charcoal">{common.preview.form_note}</p>}
        <p class="text-sm text-muted">{calc.result.disclaimer}</p>
      </div>
    </div>
  </div>

  <PrivacyNotice lang={lang} />
</section>

<script>
  import { initCalculator } from './calculatorController';

  document.querySelectorAll<HTMLElement>('[data-calculator]').forEach((root) => initCalculator(root));
</script>
