---
// Hero (UX_UI_DIRECTION.md section 5.7 item 1): ivory; eyebrow, H1 with the italic second half,
// lead, the gold apply button and, beside it, the blue link to the calculator. One gold button.
// The eyebrow, the apply label and the secondary label are other keys (CONTENT.md section 12.1).
import Button from '../layout/Button.astro';
import PolarStar from '../layout/PolarStar.astro';
import Emphasized from '../home/Emphasized.astro';
import { getCommon, getHome, type Language } from '../../i18n';
import { pageHref } from '../../lib/site/links';
import { getMastery } from './dictionary';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { mastery } = getMastery(lang);
const { vip_band, cta } = getCommon(lang);
const { hero } = getHome(lang).home;
---

<section class="overflow-hidden bg-ivory">
  <div class="relative mx-auto max-w-[1160px] px-4 py-16 lg:py-24">
    <PolarStar
      tone="sand"
      size={140}
      class="absolute right-4 top-10 hidden h-[140px] w-[140px] sm:block lg:right-8 lg:top-16 lg:h-[200px] lg:w-[200px]"
    />
    <div class="relative max-w-[44rem]">
      <p class="text-[13px] font-semibold uppercase tracking-[0.16em] text-heritage-blue">
        {vip_band.eyebrow}
      </p>
      <h1 class="mt-4 text-[clamp(2.25rem,1.7rem+2.5vw,3.5rem)] leading-[1.1]">
        <Emphasized text={mastery.title} />
      </h1>
      <p class="mt-6 max-w-[65ch] text-charcoal">{mastery.lead}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
        <Button
          variant="gold"
          href={pageHref('vip', lang)}
          label={cta.vip_apply}
          class="w-full sm:w-auto"
          data-mastery-apply
        />
        <Button
          variant="blue"
          href={pageHref('calculator', lang)}
          label={hero.secondary}
          class="w-full sm:w-auto"
          data-mastery-secondary
        />
      </div>
    </div>
  </div>
</section>
