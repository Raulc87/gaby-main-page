---
// Frequently asked questions `#preguntas` (UX_UI_DIRECTION.md sections 5.7 item 7 and 6.9): ivory;
// the title and an accordion of native <details> / <summary> elements (one per question, all
// closed at first), so the keyboard and screen readers work without script. Each card is a
// surface card with a 1 px sand border; the question in Manrope 700 with a chevron that turns
// when open. The answers are Gaby's text, which she confirms before it is published: each
// shows the pending badge in preview and development builds.
import PendingBadge from '../sections/PendingBadge.astro';
import { getCommon, type Language } from '../../i18n';
import { MASTERY_ANCHORS } from './anchors';
import { getMastery } from './dictionary';
import { showsMasteryBadge } from './pending';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { faq } = getMastery(lang).mastery;
const { pending } = getCommon(lang);
const items = [faq['1'], faq['2'], faq['3'], faq['4']];
---

<section id={MASTERY_ANCHORS.faq} tabindex="-1" class="scroll-mt-16 outline-none bg-ivory">
  <div class="mx-auto max-w-[1160px] px-4 py-16 lg:py-24">
    <h2 class="max-w-[44rem] text-[clamp(1.875rem,1.4rem+1.9vw,2.75rem)] leading-tight">{faq.title}</h2>
    <div class="mt-12 max-w-[48rem] space-y-4" data-faq>
      {
        items.map((item) => (
          <details data-faq-item class="group rounded-[4px] border border-sand bg-surface">
            <summary class="flex min-h-[52px] cursor-pointer list-none items-center justify-between gap-4 p-5 font-sans text-base font-bold text-charcoal [&::-webkit-details-marker]:hidden">
              <span>{item.question}</span>
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="h-5 w-5 shrink-0 text-heritage-blue transition-transform group-open:rotate-180"
              >
                <path d="M5 7.5l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="px-5 pb-5">
              <p class="text-base text-charcoal">{item.answer}</p>
              {showsMasteryBadge('mastery.faq') && (
                <p class="mt-3">
                  <PendingBadge label={pending.badge} />
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
