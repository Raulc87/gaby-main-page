---
// US-002, US-015 AC3: one bordered row of three cells (gold-ink "PASO 1-3"
// label, line icon, Crimson Pro step name), per UX_UI_DIRECTION.md section
// 2.1. Stacks vertically with horizontal dividers through every "common
// mobile width" (360/390/768 px, see USER_STORIES.md) and only becomes a
// 3-column row with vertical dividers at the lg breakpoint (1024 px).
import { SECTION_IDS, type RoadmapContent } from '../../i18n';

interface Props {
  content: RoadmapContent;
}

const { content } = Astro.props;
---

<section id={SECTION_IDS.roadmap} class="mx-auto max-w-5xl px-4 py-16">
  <ol class="grid divide-y divide-line rounded-[2px] border border-line bg-surface lg:grid-cols-3 lg:divide-x lg:divide-y-0">
    {
      content.steps.map((step, index) => (
        <li class="p-8">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            class="h-6 w-6 text-brand"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
          <p class="mt-4 text-xs font-semibold uppercase tracking-[0.16em] text-gold-ink">
            {content.stepLabel} {index + 1}
          </p>
          <h3 class="mt-1 text-xl text-ink">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.description}</p>
        </li>
      ))
    }
  </ol>
</section>
