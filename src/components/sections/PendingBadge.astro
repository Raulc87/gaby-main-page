---
// "Pendiente de validación" / "Pending validation" marker (US-003, US-009,
// US-011). Pill per UX_UI_DIRECTION.md section 6.5: sand fill, charcoal text,
// 12 px Manrope 600, at block level. `block` names the content block in the
// badge-block list (src/lib/site/pending.ts, CONTENT.md -> Pending badge):
// placeholders show in every build, provisional copy blocks in preview and
// development builds only. Without `block` the badge always shows (a label that
// is not a pending marker, such as the privacy notice's DRAFT label).
import { showsPendingBadge, type PendingBlockId } from '../../lib/site/pending';

interface Props {
  label: string;
  block?: PendingBlockId;
}

const { label, block } = Astro.props;
---

{
  (!block || showsPendingBadge(block)) && (
    <span class="inline-flex min-h-6 items-center rounded-full bg-sand px-3 py-1 font-sans text-xs font-semibold text-charcoal">
      {label}
    </span>
  )
}
