---
// "Pendiente de validación" / "Pending validation" marker (US-003, US-009,
// US-011). Rendering is gated by the single flag described in
// UX_UI_DIRECTION.md section 5, so every marker can be turned off at once
// for a production/stakeholder-approved build.
import { SHOW_PENDING_VALIDATION_BADGES } from '../../i18n';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

{
  SHOW_PENDING_VALIDATION_BADGES && (
    <span class="inline-flex min-h-6 items-center rounded-full bg-brand-100 px-3 py-1 text-xs font-medium text-brand-700">
      {label}
    </span>
  )
}
