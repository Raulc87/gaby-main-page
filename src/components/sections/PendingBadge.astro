---
// "Pendiente de validación" / "Pending validation" marker (US-003, US-009,
// US-011). Pill per UX_UI_DIRECTION.md section 6.5: sand fill, charcoal text,
// 12 px Manrope 600, at block level. Rendering is gated by the single flag
// described in UX_UI_DIRECTION.md section 7 until GK-020-site-shell makes it
// read the badge-block list.
import { SHOW_PENDING_VALIDATION_BADGES } from '../../i18n';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

{
  SHOW_PENDING_VALIDATION_BADGES && (
    <span class="inline-flex min-h-6 items-center rounded-full bg-sand px-3 py-1 font-sans text-xs font-semibold text-charcoal">
      {label}
    </span>
  )
}
