---
// US-003, US-015 AC3: initial call offer. Full-width heritage-blue band with a
// soft-gold polar star in the bottom-right corner and three check-marked points, per
// UX_UI_DIRECTION.md section 2.1. The points are suggested/draft content
// (section 4, Section 6; human owner, 2026-09-29), not yet validated with
// Gabriela, same status as the rest of the document (BR-004).
import PolarStar from '../layout/PolarStar.astro';
import { SECTION_IDS, type OfferContent } from '../../i18n';

interface Props {
  content: OfferContent;
}

const { content } = Astro.props;
---

<section id={SECTION_IDS.offer} class="on-blue relative overflow-hidden bg-heritage-blue pb-32 pt-16 text-center sm:pb-40">
  <!--
    The star sits in the padding reserved below the text so it never lies
    behind the paragraph at any width (UX_UI_DIRECTION.md section 2.5).
  -->
  <PolarStar tone="gold" size={140} class="absolute bottom-4 right-4 sm:bottom-6 sm:right-8" />
  <div class="relative mx-auto max-w-2xl px-4">
    <p class="max-w-[65ch] text-lg text-ivory">{content.paragraph}</p>
    <ul class="mx-auto mt-8 flex max-w-md flex-col gap-3 text-left">
      {
        content.points.map((point) => (
          <li class="flex items-start gap-3">
            <svg
              aria-hidden="true"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              class="mt-1 h-5 w-5 shrink-0 text-soft-gold"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 10l4 4 8-8" />
            </svg>
            <span class="text-ivory">{point}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
