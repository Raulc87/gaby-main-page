---
// Stub for Phase 0. Saved-preference persistence, detection override, and
// the noscript fallback described in ADR-003 are implemented in
// GK-010-i18n-toggle; for now this only links between /es/ and /en/,
// keeping the same in-page anchor when there is one.
import { LANGUAGES, type Language } from '../../i18n';

interface Props {
  lang: Language;
  label: string;
}

const { lang, label } = Astro.props;
const hash = Astro.url.hash;
---

<nav aria-label={label} class="flex items-center gap-1 text-sm font-medium">
  {
    LANGUAGES.map((code) => (
      <a
        href={`/${code}/${hash}`}
        aria-current={code === lang ? 'page' : undefined}
        class:list={[
          'flex min-h-11 min-w-11 items-center justify-center rounded-md px-2 uppercase',
          code === lang ? 'bg-brand-600 text-white' : 'text-ink-600 hover:bg-brand-50',
        ]}
      >
        {code}
      </a>
    ))
  }
</nav>
