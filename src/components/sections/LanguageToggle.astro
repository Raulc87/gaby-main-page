---
// ES | EN toggle (ADR-003, UX_UI_DIRECTION.md section 3): links to the same
// in-page anchor in the other language and saves the choice so it overrides
// browser detection on later visits.
import { LANGUAGES, type Language } from '../../i18n';

interface Props {
  lang: Language;
  label: string;
}

const { lang, label } = Astro.props;
const hash = Astro.url.hash;
---

<nav aria-label={label} class="flex items-center gap-1 text-sm font-medium" data-language-toggle>
  {
    LANGUAGES.map((code) => (
      <a
        href={`/${code}/${hash}`}
        data-lang={code}
        aria-current={code === lang ? 'page' : undefined}
        class:list={[
          'flex min-h-11 min-w-11 items-center justify-center rounded-md px-2 uppercase',
          code === lang ? 'bg-brand-600 text-white' : 'text-ink-600 hover:bg-brand-50',
        ]}
      >
        {code}
      </a>
    ))
  }
</nav>

<script>
  import { LANGUAGE_STORAGE_KEY } from '../../i18n';

  document
    .querySelectorAll<HTMLAnchorElement>('[data-language-toggle] [data-lang]')
    .forEach((link) => {
      link.addEventListener('click', () => {
        const lang = link.dataset.lang;
        if (!lang) return;
        try {
          window.localStorage.setItem(LANGUAGE_STORAGE_KEY, lang);
        } catch {
          // Storage unavailable (e.g. private browsing); navigation still works.
        }
      });
    });
</script>
