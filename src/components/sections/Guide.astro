---
// US-003, US-015 AC3/AC4: Gabriela as guide. Copy is approved provisional
// content (UX_UI_DIRECTION.md section 4); the photo/bio/credentials are
// separate "space exists but not yet provided" placeholders (US-003 AC2),
// each marked with the pending-validation badge. Round portrait (white
// ring + thin gold outline) beside the text, per section 2.1.
//
// The provisional photo file has not been provided yet (US-015
// Dependencies): the portrait frame is ready to receive it, showing a
// placeholder in the meantime.
import PendingBadge from './PendingBadge.astro';
import { SECTION_IDS, type GuideContent } from '../../i18n';

interface Props {
  content: GuideContent;
  pendingLabel: string;
}

const { content, pendingLabel } = Astro.props;
---

<section id={SECTION_IDS.guide} class="mx-auto max-w-4xl px-4 py-16">
  <div class="grid gap-10 sm:grid-cols-[auto,1fr] sm:items-start">
    <div class="relative mx-auto h-40 w-40 shrink-0 overflow-hidden rounded-full border-4 border-white shadow-md ring-1 ring-gold sm:mx-0 sm:h-48 sm:w-48">
      <div class="flex h-full w-full items-center justify-center bg-paper p-3 text-center text-xs text-muted">
        {content.photoPlaceholder}
      </div>
    </div>

    <div>
      {content.paragraphs.map((paragraph) => <p class="mt-4 max-w-[65ch] text-lg text-ink first:mt-0">{paragraph}</p>)}

      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
        <li class="flex items-center gap-2">
          <PendingBadge label={pendingLabel} />
          <span class="text-sm text-muted">{content.bioPlaceholder}</span>
        </li>
        <li class="flex items-center gap-2">
          <PendingBadge label={pendingLabel} />
          <span class="text-sm text-muted">{content.credentialsPlaceholder}</span>
        </li>
      </ul>
    </div>
  </div>
</section>
