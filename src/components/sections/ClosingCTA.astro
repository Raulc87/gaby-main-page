---
// US-003, US-019: closing statement. Surface band, Playfair Display italic
// statement plus the gold VIP CTA, per UX_UI_DIRECTION.md section 2.4. Reuses the
// hero's approved CTA copy (same action: scroll to the lead form) rather
// than inventing new closing-specific copy.
import Button from '../layout/Button.astro';
import { SECTION_IDS, type ClosingContent } from '../../i18n';

interface Props {
  content: ClosingContent;
  cta: string;
}

const { content, cta } = Astro.props;
---

<section id={SECTION_IDS.closing} class="bg-surface py-20 text-center">
  <div class="mx-auto max-w-2xl px-4">
    <p class="font-serif text-2xl italic text-charcoal sm:text-3xl">{content.paragraph}</p>
    <div class="mt-8 flex justify-center">
      <Button variant="gold" href={`#${SECTION_IDS.leadForm}`} label={cta} />
    </div>
  </div>
</section>
