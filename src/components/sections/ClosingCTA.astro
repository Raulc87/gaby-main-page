---
// US-003, US-015 AC3: closing statement. White band, Crimson Pro italic
// statement plus the CTA, per UX_UI_DIRECTION.md section 2.1. Reuses the
// hero's approved CTA copy (same action: scroll to the lead form) rather
// than inventing new closing-specific copy.
import CtaButton from './CtaButton.astro';
import { SECTION_IDS, type ClosingContent } from '../../i18n';

interface Props {
  content: ClosingContent;
  cta: string;
}

const { content, cta } = Astro.props;
---

<section id={SECTION_IDS.closing} class="mx-auto max-w-2xl px-4 py-20 text-center">
  <p class="text-2xl italic text-ink sm:text-3xl">{content.paragraph}</p>
  <div class="mt-8 flex justify-center">
    <CtaButton href={`#${SECTION_IDS.leadForm}`} label={cta} />
  </div>
</section>
