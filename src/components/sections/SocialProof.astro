---
// US-003, US-015 AC3, US-017 AC3/AC4: proof/credibility section.
// Structural placeholders only — real testimonials/outcomes are added only
// once provided by the stakeholder (UX_UI_DIRECTION.md section 4, Section
// 5); never invented here. Text and video testimonial cards are driven by
// content.cards (TestimonialCard.astro); the credibility statement is a
// separate, non-testimonial placeholder.
import PendingBadge from './PendingBadge.astro';
import TestimonialCard from './TestimonialCard.astro';
import { SECTION_IDS, type ProofContent } from '../../i18n';

interface Props {
  content: ProofContent;
  pendingLabel: string;
}

const { content, pendingLabel } = Astro.props;
---

<section id={SECTION_IDS.proof} class="mx-auto max-w-4xl px-4 py-16">
  <div class="flex flex-wrap items-center gap-3">
    <h2 class="text-3xl">{content.heading}</h2>
    <PendingBadge label={pendingLabel} />
  </div>
  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    {content.cards.map((card) => <TestimonialCard card={card} pendingLabel={pendingLabel} />)}
    <div class="rounded-[2px] border border-dashed border-line bg-surface p-6 sm:col-span-2">
      <span aria-hidden="true" class="font-serif text-4xl leading-none text-gold">
        &ldquo;
      </span>
      <p class="mt-2 text-sm text-muted">{content.credibilityPlaceholder}</p>
    </div>
  </div>
</section>
