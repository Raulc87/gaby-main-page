---
import LanguageToggle from './LanguageToggle.astro';
import { SECTION_IDS, type HeaderContent, type Language } from '../../i18n';

interface Props {
  lang: Language;
  content: HeaderContent;
}

const { lang, content } = Astro.props;
---

<header class="sticky top-0 z-50 w-full border-b border-sand bg-ivory">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a
      href={`/${lang}/#${SECTION_IDS.hero}`}
      class="flex min-h-11 items-center gap-1 font-wordmark text-charcoal"
    >
      <span class="text-xl font-medium">GK</span>
      <span class="text-lg font-medium">GabyKelly</span>
    </a>
    <LanguageToggle lang={lang} label={content.languageToggleLabel} />
  </div>
</header>
