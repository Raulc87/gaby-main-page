---
// Copy filled in by GK-001-hero (US-001).
import { SECTION_IDS, type HeroContent } from '../../i18n';

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
---

<section id={SECTION_IDS.hero} class="mx-auto max-w-3xl px-4 py-16 text-center">
  <h1 class="text-3xl font-semibold text-ink-900 sm:text-4xl">{content.headline}</h1>
  <p class="mt-4 text-lg text-ink-600">{content.supportingLine}</p>
  <a
    href={`#${SECTION_IDS.leadForm}`}
    class="mt-8 inline-flex min-h-11 items-center justify-center rounded-md bg-brand-600 px-6 py-3 text-base font-medium text-white hover:bg-brand-700"
  >
    {content.cta}
  </a>
</section>
