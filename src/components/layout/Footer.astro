---
// Footer (UX_UI_DIRECTION.md section 4.2, US-020 AC5): charcoal background,
// ivory text: wordmark and concept, the legal disclaimer and data note, the
// privacy notice link and a small soft-gold polar star. No Terms link (FR-020).
import { getCommon, type Language } from '../../i18n';
import { pageHref } from '../../lib/site/links';
import PolarStar from './PolarStar.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { footer } = getCommon(lang);
---

<footer class="bg-charcoal py-12 text-ivory">
  <div class="mx-auto flex max-w-[1160px] flex-col gap-8 px-4 md:flex-row md:items-start md:justify-between">
    <div class="max-w-md">
      <a
        href={pageHref('home', lang)}
        class="font-wordmark text-2xl font-medium text-ivory focus-visible:outline-ivory"
      >
        {footer.brand}
      </a>
      <p class="mt-2">{footer.concept}</p>
    </div>
    <div class="max-w-xl text-[15px]">
      <p>{footer.disclaimer}</p>
      <p class="mt-3">{footer.data_note}</p>
      <p class="mt-3">
        <a
          href={pageHref('privacy', lang)}
          class="inline-flex min-h-11 items-center underline underline-offset-4 focus-visible:outline-ivory"
        >
          {footer.privacy_link}
        </a>
      </p>
    </div>
    <PolarStar tone="gold" size={72} class="hidden md:block" />
  </div>
</footer>
