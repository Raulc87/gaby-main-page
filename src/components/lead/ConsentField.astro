---
// Consent checkbox (US-011, unchecked by default per BR-006). The link to
// the privacy notice opens PrivacyNotice.astro's <dialog> in place, so no
// form data is lost (AC2).
import { splitTemplate } from '../../lib/lead/format';
import type { FormDictionary } from '../../lib/lead/types';

interface Props {
  consent: FormDictionary['consent'];
}

const { consent } = Astro.props;
const { before, after } = splitTemplate(consent.text, 'privacy_notice_link');
---

<div>
  <label class="flex min-h-11 items-start gap-2 text-sm text-ink">
    <!--
      `outline`, not `border` (US-015 AC6, field-line 3:1 boundary):
      Chromium's native, appearance:auto checkbox widget ignores author
      `border-width`/`border-color` for this element (computed border stays
      0px/none regardless), but does honor `outline`, which paints
      independently of the widget's own theming. `-outline-offset-1` keeps
      it flush with the box instead of floating outside it.

      Because the unfocused state already claims the element's one
      `outline`, an unconditional field-line outline silently replaces the
      browser's native focus indicator, leaving a keyboard-focused checkbox
      looking identical to an unfocused one. `focus-visible:` swaps it to a
      `brand` outline — not `gold`: on its own, gold is only ~1.7:1 against
      white/paper, well under the 3:1 WCAG 1.4.11 non-text contrast a focus
      indicator needs, whereas `brand` reaches 6.1–6.5:1 (human owner
      review on #43). No paired `gold` ring here, unlike the inputs: the
      outline and a same-position `ring` (box-shadow) paint in the same
      1–3px band and outlines paint above box-shadows, so a `gold` ring
      tried here was fully hidden behind the `brand` outline — confirmed
      by pixel-sampling the rendered page (human owner review on #43) —
      and would have been dead weight.
    -->
    <input
      id="lead-consent"
      name="consent"
      type="checkbox"
      required
      aria-required="true"
      aria-describedby="lead-consent-error"
      class="mt-0.5 h-4 w-4 shrink-0 rounded-sm outline-1 -outline-offset-1 outline-field-line accent-brand focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-brand"
    />
    <span>
      {before}
      <button
        type="button"
        id="privacy-notice-trigger"
        aria-haspopup="dialog"
        aria-controls="privacy-notice-dialog"
        class="inline-flex min-h-11 items-center text-brand underline underline-offset-2 hover:text-navy"
      >
        {consent.linkLabel}
      </button>
      {after}
    </span>
  </label>
  <p id="lead-consent-error" role="alert" class="mt-1 text-sm text-red-700"></p>
</div>
