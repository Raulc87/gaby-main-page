---
// Consent checkbox (US-011, unchecked by default per BR-006). The link to
// the privacy notice opens PrivacyNotice.astro's <dialog> in place, so no
// form data is lost (AC2).
import { splitTemplate } from '../../lib/lead/format';
import type { FormDictionary } from '../../lib/lead/types';

interface Props {
  consent: FormDictionary['consent'];
}

const { consent } = Astro.props;
const { before, after } = splitTemplate(consent.text, 'privacy_notice_link');
---

<div>
  <label class="flex min-h-11 items-start gap-2 text-sm text-ink">
    <!--
      `outline`, not `border` (US-015 AC6, field-line 3:1 boundary):
      Chromium's native, appearance:auto checkbox widget ignores author
      `border-width`/`border-color` for this element (computed border stays
      0px/none regardless), but does honor `outline`, which paints
      independently of the widget's own theming. `-outline-offset-1` keeps
      it flush with the box instead of floating outside it.
    -->
    <input
      id="lead-consent"
      name="consent"
      type="checkbox"
      required
      aria-required="true"
      aria-describedby="lead-consent-error"
      class="mt-0.5 h-4 w-4 shrink-0 rounded-sm outline-1 -outline-offset-1 outline-field-line accent-brand"
    />
    <span>
      {before}
      <button
        type="button"
        id="privacy-notice-trigger"
        aria-haspopup="dialog"
        aria-controls="privacy-notice-dialog"
        class="inline-flex min-h-11 items-center text-brand underline underline-offset-2 hover:text-navy"
      >
        {consent.linkLabel}
      </button>
      {after}
    </span>
  </label>
  <p id="lead-consent-error" role="alert" class="mt-1 text-sm text-red-700"></p>
</div>
