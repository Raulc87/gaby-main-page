---
// Privacy notice dialog (US-011 AC2, AC5). Shows the same text as the privacy page
// (CONTENT.md section 9, via PrivacyText), with the visible DRAFT label; requires
// legal review before public launch (US-018). Opened in place via
// <dialog>.showModal() (see leadFormController.ts) so the visitor never navigates
// away and their entered form data is kept.
import PendingBadge from '../sections/PendingBadge.astro';
import type { Language } from '../../i18n';
import { getPrivacy } from '../../lib/lead/dictionaries';
import PrivacyText from './PrivacyText.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { privacy } = getPrivacy(lang);
---

<dialog
  id="privacy-notice-dialog"
  class="max-w-lg rounded-[4px] border-t-4 border-heritage-blue bg-surface p-6 backdrop:bg-charcoal/50"
>
  <div class="mb-4 flex items-start justify-between gap-4">
    <h2 class="text-lg text-charcoal">{privacy.title}</h2>
    <button
      type="button"
      id="privacy-notice-close"
      aria-label={privacy.close}
      class="min-h-11 min-w-11 text-xl leading-none text-muted hover:text-charcoal"
    >
      ×
    </button>
  </div>
  <PendingBadge label={privacy.draft_label} />
  <PrivacyText lang={lang} class="mt-4 text-sm text-muted" />
</dialog>
