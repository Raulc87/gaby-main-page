---
// Privacy notice dialog (US-011 AC2, AC5). Draft structure per Costa Rica's
// Ley N.° 8968 (UX_UI_DIRECTION.md "Privacy Notice" section); requires
// legal review before public launch, hence the visible draft marker. Opened
// in place via <dialog>.showModal() (see leadFormController.ts) so the
// visitor never navigates away and their entered form data is kept.
import PendingBadge from '../sections/PendingBadge.astro';
import type { FormDictionary } from '../../lib/lead/types';

interface Props {
  privacyNotice: FormDictionary['privacyNotice'];
  contactEmail: string;
}

const { privacyNotice, contactEmail } = Astro.props;
---

<dialog id="privacy-notice-dialog" class="max-w-lg rounded-lg p-6 backdrop:bg-ink-900/50">
  <div class="mb-4 flex items-start justify-between gap-4">
    <h2 class="text-lg font-semibold text-ink-900">{privacyNotice.title}</h2>
    <button
      type="button"
      id="privacy-notice-close"
      aria-label={privacyNotice.closeLabel}
      class="min-h-11 min-w-11 text-xl leading-none text-ink-500"
    >
      ×
    </button>
  </div>
  <PendingBadge label={privacyNotice.draftLabel} />
  <div class="mt-4 space-y-3 text-sm text-ink-700">
    {privacyNotice.paragraphs.map((paragraph) => <p>{paragraph.replaceAll('{contact_email}', contactEmail)}</p>)}
  </div>
</dialog>
