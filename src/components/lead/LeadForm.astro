---
// Owned by Implementation Agent 2. The application form (US-004, US-005, US-011,
// US-013 behavior unchanged; US-023 skin and routing). Used on the VIP page
// (`id="aplicar"`, `lang` passed) and, until GK-021-home, on the phase 1 Home
// (no props: `id` defaults to the `lead-form` anchor and the language comes from
// the URL). After a 201 the card is replaced in place by the qualified screen
// (thank-you + scheduler) or the not-ready screen, per src/lib/lead/routing.ts.
import { SECTION_IDS, type Language } from '../../i18n';
import { getCommon } from '../../i18n';
import { FEATURED_RESOURCE_ID, getResource } from '../../data/resources';
import { CONTACT_EMAIL } from '../../lib/lead/config';
import { getForm } from '../../lib/lead/dictionaries';
import { detectPageLanguage } from '../../lib/lead/language';
import { splitTemplate } from '../../lib/lead/format';
import { pageHref } from '../../lib/site/links';
import { IS_PREVIEW } from '../../lib/site/preview';
import Button from '../layout/Button.astro';
import PendingBadge from '../sections/PendingBadge.astro';
import ResourceCard from '../resources/ResourceCard.astro';
import ConsentField from './ConsentField.astro';
import PrivacyNotice from './PrivacyNotice.astro';
import ThankYou from './ThankYou.astro';
import Scheduling from './Scheduling.astro';

interface Props {
  /** Section anchor id. Default: the phase 1 Home anchor (`lead-form`). */
  id?: string;
  /** Page language. Default: resolved from the URL. */
  lang?: Language;
  /**
   * Submit button style. The VIP page uses the gold VIP button (its only gold
   * button). The default is blue: the phase 1 Home, which has no props, already
   * has the gold `ClosingCTA` right below the form, and a viewport must not show
   * two gold buttons (BR-010). Goes away with the Home's form in GK-021-home.
   */
  submitVariant?: 'gold' | 'blue';
}

const { id = SECTION_IDS.leadForm, lang: langProp, submitVariant = 'blue' } = Astro.props;
const lang = langProp ?? detectPageLanguage(Astro.url.pathname);
const form = getForm(lang);
const common = getCommon(lang);

const submissionErrorParts = splitTemplate(form.submissionError, 'contact_email');
const rateLimitedParts = splitTemplate(form.rateLimited, 'contact_email');

// Preview builds (US-027 AC3): nothing is sent, the scheduler is a static stand-in.
const preview = IS_PREVIEW;

const scriptCopy = {
  preview,
  submit: form.submit,
  fieldErrors: form.fieldErrors,
  submissionError: submissionErrorParts,
  rateLimited: rateLimitedParts,
  contactEmail: CONTACT_EMAIL,
};
---

<section
  id={id}
  data-lead-form
  class="mx-auto max-w-xl scroll-mt-24 px-4 py-12"
  data-copy={JSON.stringify(scriptCopy)}
>
  <!--
    Honeypot (US-013 AC1, UX_UI_DIRECTION.md v0.8 section 4 Section 7): its
    own <form>, entirely outside #lead-form-form. Browser autofill and
    password managers fill one form at a time; on 2026-09-30 the honeypot
    lived inside the lead form and autofill silently filled it too,
    dropping a real lead. `id`/`name` avoid autofill-recognized words
    (website, url, company, name, email, phone, tel, address, city), and
    the value is always sent to the server as `website` (contract section
    3.1, unchanged) — leadFormController.ts reads it from here. Off-screen
    (not `display: none`), `tabindex="-1"`, `aria-hidden="true"` on the
    form itself (which doubles as the wrapper), no label/placeholder/title.
    This form has no submit button, and leadFormController.ts always
    prevents its `submit` event, so pressing Enter inside it cannot reload
    the page.
  -->
  <form
    id="lead-hp-form"
    aria-hidden="true"
    class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden"
  >
    <input
      id="lead-hp"
      name="hp_field"
      type="text"
      tabindex="-1"
      autocomplete="off"
      data-1p-ignore
      data-lpignore="true"
      data-bwignore="true"
      data-form-type="other"
    />
  </form>

  <div id="lead-form-container" class="rounded-[4px] border-t-4 border-heritage-blue bg-surface p-6 sm:p-8">
    <h2 class="text-2xl text-charcoal">{form.formTitle}</h2>

    <form id="lead-form-form" novalidate class="mt-6 space-y-5">
      <div>
        <label for="lead-name" class="block text-sm font-semibold text-charcoal">{form.name.label}</label>
        <input
          id="lead-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          aria-required="true"
          aria-describedby="lead-name-hint lead-name-error"
          class="mt-1 block min-h-12 w-full rounded-[2px] border border-field-line bg-ivory px-3 py-2 text-charcoal placeholder:text-muted focus:border-heritage-blue focus:ring-2 focus:ring-heritage-blue focus:outline-none"
        />
        <p id="lead-name-hint" class="mt-1 text-sm text-muted">{form.name.hint}</p>
        <p id="lead-name-error" role="alert" class="mt-1 text-sm text-red-700"></p>
      </div>

      <div>
        <label for="lead-email" class="block text-sm font-semibold text-charcoal">{form.email.label}</label>
        <input
          id="lead-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          aria-required="true"
          aria-describedby="lead-email-error"
          class="mt-1 block min-h-12 w-full rounded-[2px] border border-field-line bg-ivory px-3 py-2 text-charcoal placeholder:text-muted focus:border-heritage-blue focus:ring-2 focus:ring-heritage-blue focus:outline-none"
        />
        <p id="lead-email-error" role="alert" class="mt-1 text-sm text-red-700"></p>
      </div>

      <div>
        <label for="lead-phone" class="block text-sm font-semibold text-charcoal">{form.phone.label}</label>
        <input
          id="lead-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          required
          aria-required="true"
          aria-describedby="lead-phone-hint lead-phone-error"
          class="mt-1 block min-h-12 w-full rounded-[2px] border border-field-line bg-ivory px-3 py-2 text-charcoal placeholder:text-muted focus:border-heritage-blue focus:ring-2 focus:ring-heritage-blue focus:outline-none"
        />
        <p id="lead-phone-hint" class="mt-1 text-sm text-muted">{form.phone.hint}</p>
        <p id="lead-phone-error" role="alert" class="mt-1 text-sm text-red-700"></p>
      </div>

      <fieldset id="lead-screening" aria-describedby="lead-screening-error" class="space-y-2">
        <legend class="block text-sm font-semibold text-charcoal">{form.screening.prompt}</legend>
        {
          form.screening.options.map((option, index) => (
            <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-[2px] border border-field-line bg-ivory px-4 py-3 text-base text-charcoal transition-colors has-[:checked]:border-heritage-blue has-[:checked]:bg-heritage-blue/10 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-heritage-blue">
              <input
                type="radio"
                name="screening_answer"
                value={option.code}
                required={index === 0}
                class="h-4 w-4 shrink-0 accent-heritage-blue"
              />
              {option.label}
            </label>
          ))
        }
        <p id="lead-screening-error" role="alert" class="mt-1 text-sm text-red-700"></p>
      </fieldset>

      <ConsentField consent={form.consent} />

      <p id="lead-submission-error" role="alert" hidden class="text-sm text-red-700"></p>

      <div>
        <Button
          id="lead-submit"
          variant={submitVariant}
          type="submit"
          label={form.submit.idle}
          class="w-full disabled:pointer-events-none disabled:opacity-50 disabled:hover:translate-y-0"
        />
        <p class="mt-3 text-center text-sm text-muted">{form.trust}</p>
      </div>
    </form>
  </div>

  <!-- Qualified screen (US-023 AC4): thank-you, then the scheduler (US-007). -->
  <div
    id="lead-success-container"
    class="rounded-[4px] border-t-4 border-heritage-blue bg-surface p-6 sm:p-8"
    hidden
  >
    <ThankYou thankYou={form.thankYou} />
    {preview && <p data-preview-note class="mt-3 text-sm font-semibold text-charcoal">{common.preview.form_note}</p>}
    <Scheduling calendlyFallback={form.calendlyFallback} preview={preview} previewNote={common.preview.scheduler} />
  </div>

  <!-- Not-ready screen (US-023 AC5, UX_UI_DIRECTION.md section 6.4): no scheduler, no gold button. -->
  <div
    id="lead-not-ready-container"
    class="rounded-[4px] border-t-4 border-heritage-blue bg-surface p-6 sm:p-8"
    hidden
  >
    <h2
      id="lead-not-ready-title"
      tabindex="-1"
      class="text-2xl text-charcoal outline-none"
    >
      {form.notReady.title}
    </h2>
    <p class="mt-3 text-base text-charcoal">{form.notReady.text}</p>
    {preview && <p data-preview-note class="mt-3 text-sm font-semibold text-charcoal">{common.preview.form_note}</p>}
    <div class="mt-3">
      <PendingBadge label={common.pending.badge} block="thanks.not_ready" />
    </div>
    <ResourceCard resource={getResource(FEATURED_RESOURCE_ID)} lang={lang} class="mt-6" />
    <div class="mt-6">
      <Button variant="blue" href={pageHref('resources', lang)} label={common.cta.all_resources} />
    </div>
  </div>

  <PrivacyNotice lang={lang} />
</section>

<script>
  import { initLeadForm } from './leadFormController';

  document.querySelectorAll<HTMLElement>('[data-lead-form]').forEach((root) => initLeadForm(root));
</script>
