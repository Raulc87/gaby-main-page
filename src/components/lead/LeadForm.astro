---
// Owned by Implementation Agent 2 (see SPRINT_001.md file ownership map).
// Built incrementally: GK-004-lead-form (name/email/phone + submission
// handling), GK-005-pre-screening (screening question), GK-011-privacy-
// consent (consent checkbox + privacy notice), GK-007-calendly (thank-you +
// inline Calendly hand-off). Resolves its own language from the URL because
// pages/{es,en}/index.astro (Agent 1) compose <LeadForm /> with no props.
import { SECTION_IDS } from '../../i18n';
import { form as enForm } from '../../i18n/en/form';
import { form as esForm } from '../../i18n/es/form';
import { CONTACT_EMAIL } from '../../lib/lead/config';
import { detectPageLanguage } from '../../lib/lead/language';
import { splitTemplate } from '../../lib/lead/format';
import ConsentField from './ConsentField.astro';
import PrivacyNotice from './PrivacyNotice.astro';
import ThankYou from './ThankYou.astro';
import Scheduling from './Scheduling.astro';

const lang = detectPageLanguage(Astro.url.pathname);
const form = lang === 'en' ? enForm : esForm;

const submissionErrorParts = splitTemplate(form.submissionError, 'contact_email');
const rateLimitedParts = splitTemplate(form.rateLimited, 'contact_email');

const scriptCopy = {
  submit: form.submit,
  fieldErrors: form.fieldErrors,
  submissionError: submissionErrorParts,
  rateLimited: rateLimitedParts,
  contactEmail: CONTACT_EMAIL,
};
---

<section id={SECTION_IDS.leadForm} class="mx-auto max-w-xl px-4 py-12" data-copy={JSON.stringify(scriptCopy)}>
  <div id="lead-form-container" class="rounded-md border-t-4 border-navy bg-surface p-6 shadow-sm sm:p-8">
    <h2 class="text-2xl font-semibold text-navy">{form.formTitle}</h2>

    <form id="lead-form-form" novalidate class="mt-6 space-y-5">
      <!--
        Honeypot (US-013, LEAD_API_CONTRACT.md section 3.1): moved off-screen
        rather than `display: none` (a hidden-by-display field is more
        commonly ignored by simple bots), removed from Tab order, and hidden
        from assistive tech; no visible label. People never see or fill it;
        its value is always sent to the server (contract section 3.1).
      -->
      <div aria-hidden="true" class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden">
        <input id="lead-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div>
        <label for="lead-name" class="block text-sm font-medium text-ink">{form.name.label}</label>
        <input
          id="lead-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          aria-required="true"
          aria-describedby="lead-name-hint lead-name-error"
          class="mt-1 block min-h-11 w-full rounded-md border border-line bg-paper px-3 py-2 text-ink placeholder:text-muted focus:border-brand focus:ring-2 focus:ring-gold focus:outline-none"
        />
        <p id="lead-name-hint" class="mt-1 text-xs text-muted">{form.name.hint}</p>
        <p id="lead-name-error" role="alert" class="mt-1 text-sm text-red-700"></p>
      </div>

      <div>
        <label for="lead-email" class="block text-sm font-medium text-ink">{form.email.label}</label>
        <input
          id="lead-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          aria-required="true"
          aria-describedby="lead-email-error"
          class="mt-1 block min-h-11 w-full rounded-md border border-line bg-paper px-3 py-2 text-ink placeholder:text-muted focus:border-brand focus:ring-2 focus:ring-gold focus:outline-none"
        />
        <p id="lead-email-error" role="alert" class="mt-1 text-sm text-red-700"></p>
      </div>

      <div>
        <label for="lead-phone" class="block text-sm font-medium text-ink">{form.phone.label}</label>
        <input
          id="lead-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          required
          aria-required="true"
          aria-describedby="lead-phone-hint lead-phone-error"
          class="mt-1 block min-h-11 w-full rounded-md border border-line bg-paper px-3 py-2 text-ink placeholder:text-muted focus:border-brand focus:ring-2 focus:ring-gold focus:outline-none"
        />
        <p id="lead-phone-hint" class="mt-1 text-xs text-muted">{form.phone.hint}</p>
        <p id="lead-phone-error" role="alert" class="mt-1 text-sm text-red-700"></p>
      </div>

      <fieldset id="lead-screening" aria-describedby="lead-screening-error" class="space-y-2">
        <legend class="block text-sm font-medium text-ink">{form.screening.prompt}</legend>
        {
          form.screening.options.map((option, index) => (
            <label class="flex min-h-11 items-center gap-3 rounded-md border border-line bg-paper px-4 py-3 text-sm text-ink transition-colors has-[:checked]:border-brand has-[:checked]:bg-brand/5 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-gold">
              <input
                type="radio"
                name="screening_answer"
                value={option.code}
                required={index === 0}
                class="h-4 w-4 shrink-0 accent-brand"
              />
              {option.label}
            </label>
          ))
        }
        <p id="lead-screening-error" role="alert" class="mt-1 text-sm text-red-700"></p>
      </fieldset>

      <ConsentField consent={form.consent} />

      <p id="lead-submission-error" role="alert" hidden class="text-sm text-red-700"></p>

      <button
        id="lead-submit"
        type="submit"
        class="group inline-flex min-h-[52px] w-full items-center justify-center gap-2 rounded-md bg-navy px-6 py-3 font-medium text-white transition hover:-translate-y-0.5 hover:bg-brand disabled:pointer-events-none disabled:opacity-60 disabled:hover:translate-y-0"
      >
        <span data-submit-label>{form.submit.idle}</span>
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          class="h-4 w-4 shrink-0 stroke-current transition-transform group-hover:translate-x-0.5"
          fill="none"
          stroke-width="1.6"
        >
          <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </form>
  </div>

  <div id="lead-success-container" class="rounded-md border-t-4 border-navy bg-surface p-6 shadow-sm sm:p-8" hidden>
    <ThankYou thankYou={form.thankYou} />
    <Scheduling calendlyFallback={form.calendlyFallback} />
  </div>

  <PrivacyNotice privacyNotice={form.privacyNotice} contactEmail={CONTACT_EMAIL} />
</section>

<script>
  import { initLeadForm } from './leadFormController';

  const root = document.getElementById('lead-form');
  if (root) initLeadForm(root);
</script>
