---
// The corporate ladder `#escalera` (UX_UI_DIRECTION.md section 5.1 item 2): surface,
// a narrow text column; `home.ladder.closing` as an editorial Playfair italic line
// with a terracotta left rule (the rule is the only terracotta, no text on it).
import { getHome, type Language } from '../../i18n';
import { ANCHORS } from '../../i18n/routes';
import Emphasized from './Emphasized.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { ladder } = getHome(lang).home;
---

<section id={ANCHORS.home.ladder} tabindex="-1" class="scroll-mt-16 outline-none bg-surface">
  <div class="mx-auto max-w-[44rem] px-4 py-16 lg:py-24">
    <h2 class="text-[clamp(1.875rem,1.4rem+1.9vw,2.75rem)] leading-tight">
      <Emphasized text={ladder.title} />
    </h2>
    <p class="mt-8 text-charcoal">{ladder.p1}</p>
    <p class="mt-6 text-charcoal"><Emphasized text={ladder.p2} /></p>
    <p class="mt-6 text-charcoal">{ladder.p3}</p>
    <p class="mt-10 border-l-4 border-terracotta pl-5 font-serif text-2xl italic leading-snug text-charcoal lg:text-3xl">
      {ladder.closing}
    </p>
  </div>
</section>
