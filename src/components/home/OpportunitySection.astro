---
// The opportunity `#oportunidad` (UX_UI_DIRECTION.md section 5.1 item 3): ivory;
// eyebrow, title, lead and six benefit cards (surface, 1 px sand border, 1.5 px line
// icon in heritage-blue) in 3 columns on desktop, 2 at 768 px, 1 on mobile.
import { getHome, type Language } from '../../i18n';
import { ANCHORS } from '../../i18n/routes';
import Emphasized from './Emphasized.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { opportunity } = getHome(lang).home;

// Simple 24 px line icons, one per benefit (in the order of CONTENT.md 5.3):
// raises, insurance, car and allowances, travel, English and access, contacts.
const icons = [
  'M3 17l6-6 4 4 8-8M15 7h6v6',
  'M12 3l8 3v6c0 4.5-3.2 8.2-8 9-4.8-.8-8-4.5-8-9V6l8-3zM9 12l2 2 4-4',
  'M3 15h18v-3.5L19 7H5l-2 4.5V15zM3 15v2.5M21 15v2.5M7 11h10',
  'M5 8h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2v-8a2 2 0 012-2zM9 8V6a1 1 0 011-1h4a1 1 0 011 1v2M3 13h18',
  'M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9z',
  'M9 5a3 3 0 100 6 3 3 0 000-6zM3 19c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5M17 7.5a2.5 2.5 0 110 5M17.5 14c2.2.3 3.5 2 3.5 4.5',
];
const cards = [opportunity['1'], opportunity['2'], opportunity['3'], opportunity['4'], opportunity['5'], opportunity['6']];
---

<section id={ANCHORS.home.opportunity} tabindex="-1" class="scroll-mt-16 outline-none bg-ivory">
  <div class="mx-auto max-w-[1160px] px-4 py-16 lg:py-24">
    <div class="max-w-[44rem]">
      <p class="text-[13px] font-semibold uppercase tracking-[0.16em] text-heritage-blue">
        {opportunity.eyebrow}
      </p>
      <h2 class="mt-3 text-[clamp(1.875rem,1.4rem+1.9vw,2.75rem)] leading-tight">
        <Emphasized text={opportunity.title} />
      </h2>
      <p class="mt-5 max-w-[65ch] text-charcoal">{opportunity.lead}</p>
    </div>
    <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((card, index) => (
          <li class="rounded-[4px] border border-sand bg-surface p-6" data-opportunity-card>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-7 w-7 text-heritage-blue"
            >
              <path d={icons[index]} />
            </svg>
            <h3 class="mt-4 text-[1.1875rem] leading-snug text-charcoal">{card.title}</h3>
            <p class="mt-2 text-base text-charcoal">{card.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
