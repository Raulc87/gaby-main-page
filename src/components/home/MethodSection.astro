---
// Método Polaris `#metodo` (UX_UI_DIRECTION.md section 5.1 item 6): surface; eyebrow,
// title and lead (Polaris is the North Star), the polar star beside the title; Gaby's
// three official pillars as equal cards in a row (stacked below 768 px), each with its
// official name as a small label above its short name and one line. The pillars are
// worked in parallel, so there are no numbers, no arrows and no order between them.
// Then the closing line, the blue `home.method.cta` (the shared `cta.vip_apply`, to the
// application page; blue, never gold: BR-010) and, beside it, the text link
// `home.method.link` to the Wealth Mastery page (its arrow is drawn here).
import Button from '../layout/Button.astro';
import PolarStar from '../layout/PolarStar.astro';
import { getCommon, getHome, type Language } from '../../i18n';
import { ANCHORS } from '../../i18n/routes';
import { pageHref } from '../../lib/site/links';
import Emphasized from './Emphasized.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { method } = getHome(lang).home;
const { cta } = getCommon(lang);
const pillars = [method['1'], method['2'], method['3']];
---

<section id={ANCHORS.home.method} tabindex="-1" class="scroll-mt-16 outline-none bg-surface">
  <div class="mx-auto max-w-[1160px] px-4 py-16 lg:py-24">
    <div class="flex items-start justify-between gap-6">
      <div class="max-w-[44rem]">
        <p class="text-[13px] font-semibold uppercase tracking-[0.16em] text-heritage-blue">
          {method.eyebrow}
        </p>
        <h2 class="mt-3 text-[clamp(1.875rem,1.4rem+1.9vw,2.75rem)] leading-tight">
          <Emphasized text={method.title} />
        </h2>
        <p class="mt-5 max-w-[65ch] text-charcoal">{method.lead}</p>
      </div>
      <PolarStar tone="sand" size={96} class="hidden h-[96px] w-[96px] sm:block lg:h-[140px] lg:w-[140px]" />
    </div>
    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        pillars.map((pillar) => (
          <li class="rounded-[4px] border border-sand bg-ivory p-6" data-method-pillar>
            <p class="text-[13px] font-semibold uppercase tracking-[0.16em] text-heritage-blue">
              {pillar.label}
            </p>
            <h3 class="mt-3 text-[1.1875rem] leading-snug text-charcoal">{pillar.title}</h3>
            <p class="mt-2 text-base text-charcoal">{pillar.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-12 max-w-[44rem] font-bold text-charcoal">{method.closing}</p>
    <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
      <Button variant="blue" href={pageHref('vip', lang)} label={cta.vip_apply} class="w-full sm:w-auto" />
      <a
        href={pageHref('mastery', lang)}
        class="inline-flex min-h-11 items-center gap-2 font-semibold text-heritage-blue underline-offset-4 hover:underline"
      >
        {method.link}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
