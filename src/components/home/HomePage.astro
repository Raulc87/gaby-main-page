---
// The Home (US-034, UX_UI_DIRECTION.md section 5.1, CONTENT.md section 5): hero, problem,
// stakes, guide, opportunity, Método Polaris, Wealth Mastery, before and after, proof,
// calculator and the VIP band, in that order. The application form lives on the VIP page;
// every VIP call to action leads there. Gold buttons: the hero's and the closing band's
// only, with blue sections between them (BR-010).
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Language } from '../../i18n';
import CalculatorSection from './CalculatorSection.astro';
import ChangeSection from './ChangeSection.astro';
import GuideSection from './GuideSection.astro';
import HomeHero from './HomeHero.astro';
import HomeVipSection from './HomeVipSection.astro';
import LadderSection from './LadderSection.astro';
import MasterySection from './MasterySection.astro';
import MethodSection from './MethodSection.astro';
import OpportunitySection from './OpportunitySection.astro';
import StakesSection from './StakesSection.astro';
import TestimonialsSection from './TestimonialsSection.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<BaseLayout lang={lang} pageId="home">
  <HomeHero lang={lang} />
  <LadderSection lang={lang} />
  <StakesSection lang={lang} />
  <GuideSection lang={lang} />
  <OpportunitySection lang={lang} />
  <MethodSection lang={lang} />
  <MasterySection lang={lang} />
  <ChangeSection lang={lang} />
  <TestimonialsSection lang={lang} />
  <CalculatorSection lang={lang} />
  <HomeVipSection lang={lang} />
</BaseLayout>
