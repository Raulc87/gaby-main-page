---
// Hero `#hero` (UX_UI_DIRECTION.md section 5.1 item 1, CONTENT.md section 5.1): ivory,
// two columns on desktop. Left: eyebrow, H1 (italic second half), lead, the gold
// `home.hero.cta` to the VIP page, the blue `home.hero.secondary` to the calculator
// and the trust line. Right: the "desired state" photo frame (4:5, rounded) with a
// soft-gold polar star; until the photo arrives it is a sand frame with the placeholder
// text and the pending badge (every build, BR-011). The studio portrait is not used here.
import Button from '../layout/Button.astro';
import PolarStar from '../layout/PolarStar.astro';
import PendingBadge from '../sections/PendingBadge.astro';
import { getCommon, getHome, type Language } from '../../i18n';
import { ANCHORS } from '../../i18n/routes';
import { pageHref } from '../../lib/site/links';
import Emphasized from './Emphasized.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { hero } = getHome(lang).home;
const { pending } = getCommon(lang);
---

<section id={ANCHORS.home.hero} tabindex="-1" class="scroll-mt-16 outline-none overflow-hidden bg-ivory">
  <div class="mx-auto grid max-w-[1160px] items-center gap-12 px-4 py-16 lg:grid-cols-[1.2fr_1fr] lg:gap-16 lg:py-24">
    <div>
      <p class="text-[13px] font-semibold uppercase tracking-[0.16em] text-heritage-blue">
        {hero.eyebrow}
      </p>
      <h1 class="mt-4 text-[clamp(2.5rem,1.9rem+2.9vw,4rem)] leading-[1.1]">
        <Emphasized text={hero.title} />
      </h1>
      <p class="mt-6 max-w-[65ch] text-charcoal">{hero.lead}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
        <Button variant="gold" href={pageHref('vip', lang)} label={hero.cta} class="w-full sm:w-auto" />
        <Button variant="blue" href={pageHref('calculator', lang)} label={hero.secondary} class="w-full sm:w-auto" />
      </div>
      <p class="mt-6 text-sm text-muted">{hero.trust}</p>
    </div>

    <div class="flex justify-center lg:justify-end">
      <div class="relative w-full max-w-[22rem]">
        <PolarStar
          tone="gold"
          size={96}
          class="absolute -right-3 -top-6 z-10 h-[96px] w-[96px] lg:-right-8 lg:-top-8 lg:h-[140px] lg:w-[140px]"
        />
        <div
          data-hero-photo-frame
          role="img"
          aria-label={hero.photo_alt}
          class="flex aspect-[4/5] w-full flex-col items-center justify-center gap-4 rounded-[4px] bg-sand p-6 text-center"
        >
          <p class="max-w-[16rem] font-serif text-xl text-charcoal">{hero.photo.placeholder}</p>
          <PendingBadge label={pending.badge} block="home.hero_photo" />
        </div>
      </div>
    </div>
  </div>
</section>
