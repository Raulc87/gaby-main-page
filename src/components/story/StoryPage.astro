---
// My story page (US-022, UX_UI_DIRECTION.md section 5.2, CONTENT.md section 6).
// Hero with eyebrow, title and the session-photo placeholder; the three story
// paragraphs in a narrow column; the media row (names as text chips in
// same-height boxes that can take logos later); the experience row (Microsoft and
// Oracle logos from public/logos, Intel as text); the bio and credentials
// placeholder; the text link to the resources; the VIP band. The photo and bio
// placeholders carry the pending badge in every build (they are placeholders).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PendingBadge from '../sections/PendingBadge.astro';
import PolarStar from '../layout/PolarStar.astro';
import VipBand from '../layout/VipBand.astro';
import { getCommon, type Language } from '../../i18n';
import { story as storyEs } from '../../i18n/es/story';
import { story as storyEn } from '../../i18n/en/story';
import { parseEmphasis } from '../../lib/site/emphasis';
import { assetUrl, pageHref } from '../../lib/site/links';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const story = lang === 'es' ? storyEs : storyEn;
const common = getCommon(lang);
const title = parseEmphasis(story.title);
const mediaNames = [story.media['1'], story.media['2'], story.media['3'], story.media['4']];
---

<BaseLayout lang={lang} pageId="story">
  <section class="bg-ivory">
    <div class="mx-auto grid max-w-[1160px] items-center gap-10 px-4 py-16 lg:grid-cols-[1.4fr_1fr] lg:gap-16 lg:py-24">
      <div>
        <p class="text-[13px] font-semibold uppercase tracking-[0.16em] text-heritage-blue">
          {story.eyebrow}
        </p>
        <h1 class="mt-3 text-[clamp(2.375rem,1.84rem+2.39vw,3.75rem)] leading-tight">
          {
            title.map((segment) =>
              segment.emphasis ? (
                <em class="italic text-heritage-blue">{segment.text}</em>
              ) : (
                segment.text
              ),
            )
          }
        </h1>
      </div>
      <div
        data-testid="story-photo-placeholder"
        class="relative flex min-h-[220px] flex-col items-center justify-center gap-3 overflow-hidden rounded-[4px] bg-heritage-blue p-6 text-center text-ivory"
      >
        <PolarStar tone="gold" size={56} class="h-14 w-14" />
        <p class="text-ivory">{story.photo.placeholder}</p>
        <PendingBadge label={common.pending.badge} block="story.photo" />
      </div>
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto max-w-[44rem] px-4 py-16 lg:py-24">
      <p class="text-lg text-charcoal">{story.p1}</p>
      <p class="mt-6 text-lg text-charcoal">{story.p2}</p>
      <p class="mt-6 text-lg text-charcoal">{story.p3}</p>
      <p class="mt-8">
        <a
          href={pageHref('resources', lang)}
          class="font-semibold text-heritage-blue underline underline-offset-4"
          data-testid="story-resources-link"
        >
          {common.cta.start_free}
        </a>
      </p>
    </div>
  </section>

  <section class="bg-ivory">
    <div class="mx-auto max-w-[1160px] px-4 py-16 lg:py-24">
      <div data-testid="story-media">
        <p class="text-[13px] font-semibold uppercase tracking-[0.16em] text-heritage-blue">
          {story.media.label}
        </p>
        <ul class="mt-4 flex flex-wrap gap-3">
          {
            mediaNames.map((name) => (
              <li class="flex h-14 items-center rounded-[4px] border border-sand bg-surface px-6 font-semibold text-charcoal">
                {name}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-12" data-testid="story-experience">
        <p class="text-[13px] font-semibold uppercase tracking-[0.16em] text-heritage-blue">
          {story.experience.label}
        </p>
        <ul class="mt-4 flex flex-wrap items-center gap-3">
          <li class="flex h-14 items-center rounded-[4px] border border-sand bg-surface px-6">
            <img
              src={assetUrl('/logos/microsoft.svg')}
              alt={story.experience.logo_alt.microsoft}
              width="131"
              height="28"
              class="h-7 w-auto grayscale"
            />
          </li>
          <li class="flex h-14 items-center rounded-[4px] border border-sand bg-surface px-6">
            <img
              src={assetUrl('/logos/oracle.svg')}
              alt={story.experience.logo_alt.oracle}
              width="216"
              height="28"
              class="h-7 w-auto grayscale"
            />
          </li>
          <li class="flex h-14 items-center rounded-[4px] border border-sand bg-surface px-6 font-semibold text-charcoal">
            {story.experience.intel}
          </li>
        </ul>
      </div>

      <div
        data-testid="story-bio-placeholder"
        class="mt-12 flex max-w-[44rem] flex-wrap items-center gap-3 rounded-[4px] border border-sand bg-surface p-6"
      >
        <PendingBadge label={common.pending.badge} block="story.bio" />
        <span class="text-muted">{story.bio.placeholder}</span>
      </div>
    </div>
  </section>

  <VipBand lang={lang} />
</BaseLayout>
