---
// Language detection per ADR-003 / US-010 and US-020 AC6: the saved toggle
// choice first, otherwise the browser's preferred language, keeping the URL
// hash, then the Home in that language (through the base path). The <noscript>
// block is the fallback described in US-010 AC6.
import { getCommon } from '../i18n';
import { pageHref } from '../lib/site/links';
import { IS_PREVIEW } from '../lib/site/preview';

const homeEs = pageHref('home', 'es');
const homeEn = pageHref('home', 'en');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{getCommon('es').meta.site_name}</title>
    {IS_PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    <script>
      import { LANGUAGE_STORAGE_KEY, detectLanguage } from '../i18n';
      import { pageHref } from '../lib/site/links';

      let storedPreference: string | null = null;
      try {
        storedPreference = window.localStorage.getItem(LANGUAGE_STORAGE_KEY);
      } catch {
        // Storage unavailable (e.g. private browsing); fall back to detection.
        storedPreference = null;
      }

      const lang = detectLanguage({
        storedPreference,
        browserLanguages: navigator.languages ?? [navigator.language],
      });

      window.location.replace(`${pageHref('home', lang)}${window.location.hash}`);
    </script>
  </head>
  <body>
    <noscript>
      <p><a href={homeEs}>Español</a> · <a href={homeEn}>English</a></p>
    </noscript>
  </body>
</html>
