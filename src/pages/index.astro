---
// Language detection per ADR-003 / US-010: the saved toggle choice first,
// otherwise the browser's preferred language, keeping the URL hash.
// The <noscript> block is the fallback described in US-010 AC6.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gabriela Kelly</title>
    <script>
      import { LANGUAGE_STORAGE_KEY, detectLanguage } from '../i18n';

      let storedPreference: string | null = null;
      try {
        storedPreference = window.localStorage.getItem(LANGUAGE_STORAGE_KEY);
      } catch {
        // Storage unavailable (e.g. private browsing); fall back to detection.
        storedPreference = null;
      }

      const lang = detectLanguage({
        storedPreference,
        browserLanguages: navigator.languages ?? [navigator.language],
      });

      window.location.replace(`/${lang}/${window.location.hash}`);
    </script>
  </head>
  <body>
    <noscript>
      <p><a href="/es/">Español</a> · <a href="/en/">English</a></p>
    </noscript>
  </body>
</html>
