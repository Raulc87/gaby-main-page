---
// Language detection per ADR-003 / US-010 and US-020 AC6: the saved toggle
// choice first, otherwise the browser's preferred language, keeping the URL
// hash, then the Home in that language (through the base path). The <noscript>
// block is the fallback described in US-010 AC6. In preview builds the page shows
// the visible preview marker (UX_UI_DIRECTION.md section 6.6, US-027 AC2), in both
// languages because the chooser serves both; with JavaScript off a visitor stays
// here, so the marker must not depend on the redirect.
import '../styles/global.css';
import PreviewBar from '../components/layout/PreviewBar.astro';
import { getCommon } from '../i18n';
import { pageHref } from '../lib/site/links';
import { IS_PREVIEW } from '../lib/site/preview';

const homeEs = pageHref('home', 'es');
const homeEn = pageHref('home', 'en');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{getCommon('es').meta.site_name}</title>
    {IS_PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    <script>
      import { LANGUAGE_STORAGE_KEY, detectLanguage } from '../i18n';
      import { pageHref } from '../lib/site/links';

      let storedPreference: string | null = null;
      try {
        storedPreference = window.localStorage.getItem(LANGUAGE_STORAGE_KEY);
      } catch {
        // Storage unavailable (e.g. private browsing); fall back to detection.
        storedPreference = null;
      }

      const lang = detectLanguage({
        storedPreference,
        browserLanguages: navigator.languages ?? [navigator.language],
      });

      window.location.replace(`${pageHref('home', lang)}${window.location.hash}`);
    </script>
  </head>
  <body>
    <PreviewBar lang="es" />
    <div lang="en"><PreviewBar lang="en" /></div>
    <noscript>
      <p class="mx-auto flex max-w-[1160px] flex-wrap items-center gap-x-4 px-4 py-8 text-lg">
        <a
          href={homeEs}
          lang="es"
          class="inline-flex min-h-11 items-center font-semibold text-heritage-blue underline underline-offset-4"
        >
          Español
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={homeEn}
          lang="en"
          class="inline-flex min-h-11 items-center font-semibold text-heritage-blue underline underline-offset-4"
        >
          English
        </a>
      </p>
    </noscript>
  </body>
</html>
