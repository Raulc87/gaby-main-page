# Frontend configuration (Astro public build-time variables).
# See docs/specs/LEAD_API_CONTRACT.md section 9.
#
# Copy this file to .env (or .env.local) and adjust values for your machine.
# .env is git-ignored; never commit real values here.

# Path the lead form posts to. The Astro dev server proxies this to the
# local Flask server (see astro.config.mjs and docs/runbooks/LOCAL_DEVELOPMENT.md).
PUBLIC_LEAD_ENDPOINT=/api/save-lead

# Calendly scheduling URL, embedded inline after a successful lead save
# (US-007). Placeholder until Gabriela provides the real link.
PUBLIC_CALENDLY_URL=https://calendly.com/your-account/intro-call

# Fallback contact email used as a mailto: link when Calendly is
# unavailable or not configured.
PUBLIC_CONTACT_EMAIL=gkelly@poliartcr.com
