# Frontend configuration (Astro public build-time variables).
# See docs/specs/LEAD_API_CONTRACT.md section 9.
#
# Copy this file to .env (or .env.local) and adjust values for your machine.
# .env is git-ignored; never commit real values here.

# Path the lead form posts to. The Astro dev server proxies this to the
# local Flask server (see astro.config.mjs and docs/runbooks/LOCAL_DEVELOPMENT.md).
PUBLIC_LEAD_ENDPOINT=/api/save-lead

# Path the calculator posts its lead to before showing the result
# (US-036, contract v1.2 section 11). Proxied like the lead endpoint.
PUBLIC_CALCULATOR_ENDPOINT=/api/save-calculator-lead

# Colones per US dollar for the calculator's currency switch (FR-034). Default 500.
PUBLIC_CRC_PER_USD=500

# Gaby's GoHighLevel booking widget, embedded after a saved application
# (ADR-006). Use the final widget URL, not one that redirects.
PUBLIC_SCHEDULER_URL=https://api.leadconnectorhq.com/widget/booking/your-calendar-id

# Fallback contact email used as a mailto: link when the booking widget is
# unavailable or not configured.
PUBLIC_CONTACT_EMAIL=gkelly@poliartcr.com
