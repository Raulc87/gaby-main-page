# Backend configuration (read from environment variables by api/config.py).
# See docs/specs/LEAD_API_CONTRACT.md section 9.
#
# Copy this file to api/.env and adjust values for your machine.
# .env is git-ignored; never commit real values or key files here.

# "memory" for local development and automated tests (no Google account
# needed). "google_sheets" to persist real leads (see
# docs/runbooks/GOOGLE_SHEETS_SETUP.md).
LEADS_STORAGE=memory

# Absolute path to the Google service-account JSON key file, stored
# outside the web root. Only required when LEADS_STORAGE=google_sheets.
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/outside/webroot/service-account.json

# Target Google Sheet ID (the long ID in the sheet's URL). Only required
# when LEADS_STORAGE=google_sheets.
GOOGLE_SHEET_ID=your-google-sheet-id

# Worksheet (tab) name inside the sheet. Defaults to "leads" if unset.
GOOGLE_SHEET_TAB=leads

# Worksheet (tab) name for calculator leads (US-036). Defaults to
# "calculator" if unset. Same sheet as above, its own tab and header row
# (docs/runbooks/GOOGLE_SHEETS_SETUP.md).
GOOGLE_SHEET_CALCULATOR_TAB=calculator

# Identifier of the privacy notice version visitors are accepting when
# they submit the form (stored with every lead). Example: 2026-11-draft-2.
PRIVACY_NOTICE_VERSION=2026-11-draft-2

# Spam protection (US-013, ADR-004): per-IP sliding-window rate limit on
# POST /save-lead and, with its own separate budget, on
# POST /save-calculator-lead (contract v1.2 section 11.1). Disabled here (0) for local development; production
# should set a real limit (defaults if unset: 5 requests / 600 seconds).
RATE_LIMIT_MAX_REQUESTS=0
RATE_LIMIT_WINDOW_SECONDS=600
